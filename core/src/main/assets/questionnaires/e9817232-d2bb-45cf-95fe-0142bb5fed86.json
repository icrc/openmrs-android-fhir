kId":"formCompleteness","definition":"http://hl7.org/fhir/StructureDefinition/Observation#Observation.valueCodeableConcept.coding","text":"Form Completeness","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Exhaustivité du formulaire"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"اكتمال النموذج"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Заполненность формы"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Integridad del Formulario"}]}]},"type":"choice","required":true,"answerOption":[{"valueCoding":{"code":"6cf29178-21a8-4737-89b3-49bb3f141c89","display":"Complete","_display":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Complet"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"مكتمل"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Завершено"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Completo"}]}]}}},{"valueCoding":{"code":"163339AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","display":"Incomplete","_display":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Incomplet"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"غير مكتمل"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Неполный"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Incompleto"}]}]}}}]}]},{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/questionnaire-hidden","valueBoolean":true}],"linkId":"formCompleteness-obs","definition":"http://hl7.org/fhir/StructureDefinition/Observation#Observation.code","type":"choice","initial":[{"valueCoding":{"code":"cb22cf53-a9d9-4923-947e-281694a54f0e","display":"Form Completeness","_display":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Exhaustivité du formulaire"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"اكتمال النموذج"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Заполненность формы"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Integridad del Formulario"}]}]}}}]}]}]}]},{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl","valueCodeableConcept":{"coding":[{"system":"http://hl7.org/fhir/questionnaire-item-control","code":"page","display":"Page"}],"text":"Page"}}],"linkId":"page-score","type":"group","item":[{"linkId":"section-who-","text":"WHO-5","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"WHO-5"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"WHO-5"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"ВОЗ-5"}]}]},"type":"group","item":[{"linkId":"who5-raw-scoring-instructions","text":"Scoring: The raw score is calculated by totaling the scores on each of the five questions. The raw score ranges from zero to 25, zero representing worst possible mental well-being and 25 representing best possible mental well-being.","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Score : Le score brut est calculé en additionnant les scores de chacune des cinq questions. Le score brut varie de zéro à 25, zéro représentant le pire bien-être mental possible et 25 représentant le meilleur bien-être mental possible."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Puntuación: La puntuación bruta se calcula sumando las puntuaciones de cada una de las cinco preguntas. La puntuación bruta oscila entre cero y 25, donde cero representa el peor bienestar mental posible y 25 representa el mejor bienestar mental posible."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Подсчет баллов: Общий балл рассчитывается путем суммирования ответов на каждый из пяти вопросов. Общий балл варьируется от 0 до 25, где 0 означает наихудшее психологическое благополучие, а 25 — наилучшее."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"التسجيل: يتم حساب الدرجة الخام عن طريق جمع الدرجات لكل سؤال من الأسئلة الخمسة. تتراوح الدرجة الخام من صفر إلى 25، حيث يمثل الصفر أسوأ حالة عافية نفسية ممكنة وتمثل 25 أفضل حالة عافية نفسية ممكنة."}]}]},"type":"display"},{"linkId":"who5-cutoff-instructions","text":"Comment: A percentage score below 13 has been suggested as a cut-off for poor mental well-being and as an indication for further assessment for the possible presence of a mental health condition (e.g., depressive disorder).","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Commentaire : Un score en pourcentage inférieur à 13 a été suggéré comme seuil de mauvais bien-être mental et comme indication pour une évaluation plus approfondie de la présence possible d'un trouble de santé mentale (par exemple, un trouble dépressif)."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Comentario: Se ha sugerido una puntuación porcentual inferior a 13 como punto de corte para un bienestar mental deficiente y como indicación para una evaluación posterior ante la posible presencia de una afección de salud mental (p. ej., trastorno depresivo)."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Комментарий: Процентный балл ниже 13 был предложен в качестве порогового значения для низкого уровня психологического благополучия и как показание для дальнейшего обследования на предмет возможного наличия психического расстройства (например, депрессивного расстройства)."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"تعليق: تم اقتراح درجة مئوية أقل من 13 كحد قاطع لضعف العافية النفسية وكإشارة لمزيد من التقييم لاحتمال وجود حالة صحية نفسية (مثل اضطراب الاكتئاب)."}]}]},"type":"display"},{"extension":[{"url":"http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-itemExtractionContext","valueExpression":{"name":"totalScore","language":"application/x-fhir-query","expression":"Observation"}}],"linkId":"totalScore-group","type":"group","item":[{"extension":[{"url":"http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression","valueExpression":{"language":"text/fhirpath","expression":"%q1Score + %q2Score + %q3Score + %q4Score + %q5Score"}},{"url":"http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression","valueExpression":{"language":"text/fhirpath","expression":"%observations.entry.resource.ofType(Observation).where(code.coding.code = '8b7044b2-ced4-4ba5-a9b1-b7f4994fcec6').value"}}],"linkId":"totalScore","definition":"http://hl7.org/fhir/StructureDefinition/Observation#Observation.valueInteger","text":"Total score","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Score total"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"النتيجة الكلية"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Общий балл"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Puntuación total"}]}]},"type":"integer","required":true,"readOnly":true},{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/questionnaire-hidden","valueBoolean":true}],"linkId":"totalScore-obs","definition":"http://hl7.org/fhir/StructureDefinition/Observation#Observation.code","type":"choice","initial":[{"valueCoding":{"code":"8b7044b2-ced4-4ba5-a9b1-b7f4994fcec6","display":"Total score","_display":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Score total"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valu