.first().value.code='1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA', 0, 0)))"}},{"url":"http://hl7.org/fhir/StructureDefinition/variable","valueExpression":{"name":"q4Score","language":"text/fhirpath","expression":"iif(%resource.repeat(item).where(linkId='q4').answer.first().value.code.empty(), 0, iif(%resource.repeat(item).where(linkId='q4').answer.first().value.code='1065AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA', 1, iif(%resource.repeat(item).where(linkId='q4').answer.first().value.code='1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA', 0, 0)))"}},{"url":"http://hl7.org/fhir/StructureDefinition/variable","valueExpression":{"name":"q5Score","language":"text/fhirpath","expression":"iif(%resource.repeat(item).where(linkId='q5').answer.first().value.code.empty(), 0, iif(%resource.repeat(item).where(linkId='q5').answer.first().value.code='1065AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA', 1, iif(%resource.repeat(item).where(linkId='q5').answer.first().value.code='1066AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA', 0, 0)))"}}],"title":"PC-PTSD-5","_title":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"استمارة IES-R"}]}]},"status":"active","subjectType":["Encounter","Patient","Practitioner"],"date":"2025-07-21T16:07:42Z","code":[{"system":"http://fhir.openmrs.org/code-system/encounter-type","code":"dfc44987-ff14-4510-91c5-d96d053bb93a","display":"PC-PTSD-5"},{"system":"http://fhir.openmrs.org/core/StructureDefinition/omrs-form","code":"ca854081-3b74-355e-a704-5eabf892da7e","display":"PC-PTSD-5"}],"item":[{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl","valueCodeableConcept":{"coding":[{"system":"http://hl7.org/fhir/questionnaire-item-control","code":"page","display":"Page"}],"text":"Page"}}],"linkId":"page-pc-ptsd-5","type":"group","item":[{"linkId":"section-PC-PTSD-5","text":"PC-PTSD – 5 (Primary Care PTSD Screen for DSM-5)","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"PC-PTSD – 5 (Dépistage du TSPT en Soins Primaires selon le DSM-5)"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"PC-PTSD – 5 (فحص اضطراب ما بعد الصدمة للرعاية الأولية وفقًا للدليل التشخيصي والإحصائي للاضطرابات النفسية 5)"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"PC-PTSD – 5 (Скрининг ПТСР для первичной медико-санитарной помощи по DSM-5)"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"PC-TEPT – 5 (Cribado de TEPT para Atención Primaria para el DSM-5)"}]}]},"type":"group","item":[{"linkId":"pc-ptsd5-objective-instructions","text":"Objective: Screens for PTSD symptoms based on DSM-5 criteria.","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Objectif : Dépistage des symptômes du SSPT basés sur les critères du DSM-5."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Objetivo: Detecta síntomas de TEPT según los criterios del DSM-5."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Цель: Скрининг симптомов ПТСР на основе критериев DSM-5."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"الهدف: فحص أعراض اضطراب ما بعد الصدمة بناءً على معايير DSM-5."}]}]},"type":"display"},{"linkId":"pc-ptsd5-target-population-instructions","text":"Target Population: Adults (18+) with suspected PTSD.","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Population cible : Adultes (18 ans et plus) avec suspicion de SSPT."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"Población objetivo: Adultos (18+) con sospecha de TEPT."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Целевая группа: Взрослые (18+) с подозрением на ПТСР."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"الفئة المستهدفة: البالغون (18+) المشتبه في إصابتهم باضطراب ما بعد الصدمة."}]}]},"type":"display"},{"linkId":"pc-ptsd5-overview-instructions","text":"The Primary Care PTSD Screen for DSM-5 (PC-PTSD-5) is a 5-item screen designed to identify individuals with probable PTSD. Those screening positive require further assessment, preferably with a structured interview.","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Le Primary Care PTSD Screen pour le DSM-5 (PC-PTSD-5) est un test de 5 items conçu pour identifier les individus présentant un SSPT probable. Les personnes dont le résultat est positif nécessitent une évaluation plus approfondie, de préférence par un entretien structuré."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"El Cuestionario de Detección de TEPT en Atención Primaria para el DSM-5 (PC-PTSD-5) es una prueba de 5 ítems diseñada para identificar a personas con probable TEPT. Quienes obtengan un resultado positivo requieren una evaluación adicional, preferiblemente mediante una entrevista estructurada."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Скрининг ПТСР для первичной медико-санитарной помощи по DSM-5 (PC-PTSD-5) — это тест из 5 пунктов, предназначенный для выявления лиц с вероятным ПТСР. Лицам с положительным результатом скрининга требуется дальнейшее обследование, желательно с использованием структурированного интервью."}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"يعد فحص اضطراب ما بعد الصدمة في الرعاية الأولية لـ DSM-5 (PC-PTSD-5) عبارة عن فحص مكون من 5 عناصر مصمم لتحديد الأفراد المحتمل إصابتهم باضطراب ما بعد الصدمة. يتطلب أولئك الذين تظهر نتيجة فحصهم إيجابية مزيداً من التقييم، ويفضل أن يكون ذلك من خلال مقابلة منظمة."}]}]},"type":"display"},{"linkId":"pc-ptsd5-trauma-examples-instructions","text":"Sometimes things happen to people that are unusually or especially frightening, horrible, or traumatic. For example: a serious accident or fire; a physical or sexual assault or abuse; an earthquake or flood; a war; seeing someone be killed or seriously injured; having a loved one die through homicide or suicide;","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Parfois, il arrive aux gens des choses inhabituellement ou particulièrement effrayantes, horribles ou traumatisantes. Par exemple : un accident grave ou un incendie ; une agression ou un abus physique ou sexuel ; un tremblement de terre ou une inondation ; une guerre ; voir quelqu'un se faire tuer ou être gravement blessé ; perdre un proche par homicide ou suicide ;"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"es"},{"url":"content","valueString":"A veces a las personas les suceden cosas que son inusualmente o especialmente aterradoras, horribles o traumáticas. Por ejemplo: un accidente o incendio grave; una agresión o abuso físico o sexual; un terremoto o inundación; una guerra; ver a alguien morir o resultar gravemente herido; la muerte de un ser querido por homicidio o suicidio;"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Иногда с людьми случаются вещи, которые являются необычно или особенно пугающими, ужасными или травмирующими. Например: серьезная авария или пожар; физическое или сексуальное насилие или злоупотребление; землетрясение или наводнение; война; наблюдение за тем, как кого-то убивают или серьезно ранят; смерть близкого человека в результате убийства или самоубийства;"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"تحدث أحياناً أشياء للناس تكون مخيفة أو مروعة أو صادمة بشكل غير عادي أو خاص. على سبيل المثال: حادث خطير أو حريق؛ اعتداء أو سوء معاملة جسدية أو جنسية؛ زلزال أو فيضان؛ حرب؛ رؤية شخص يُقتل أو يُصاب بجروح خطيرة؛ وفاة أحد الأحباء بسبب القتل العمد أو الانتحار؛"}]}]},"type":"display"},{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl","valueCodeableConcept":{"coding":[{"system":"http://hl7.org/fhir/questionnaire-item-control","code":"dateTime"}]}}],"linkId":"encounter-encounterDate","definition":"http://hl7.org/fhir/StructureDefinition/Observation#Observation.valueDateTime","text":"Encounter Date","_text":{"extension":[{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"fr"},{"url":"content","valueString":"Date de la consultation"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ar"},{"url":"content","valueString":"تاريخ اللقاء"}]},{"url":"http://hl7.org/fhir/StructureDefinition/translation","extension":[{"url":"lang","valueCode":"ru"},{"url":"content","valueString":"Дата встречи"}]},{"u