<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue_40</item>
        <item name="colorOnPrimary">@color/onPrimary_blue_100</item>
        <item
            name="colorPrimaryContainer"
        >@color/primaryContainer_blue_90</item>
        <item name="android:windowLightStatusBar">true</item>
        <item
            name="colorOnPrimaryContainer"
        >@color/onPrimaryContainer_blue_10</item>

        <item name="colorSecondary">@color/secondary_blue_40</item>
        <item name="colorOnSecondary">@color/onSecondary_blue_100</item>
        <item
            name="colorSecondaryContainer"
        >@color/secondaryContainer_blue_90</item>
        <item
            name="colorOnSecondaryContainer"
        >@color/onSecondaryContainer_blue_10</item>

        <item name="colorTertiary">@color/tertiary_green_40</item>
        <item name="colorOnTertiary">@color/onTertiary_green_100</item>
        <item
            name="colorTertiaryContainer"
        >@color/tertiaryContainer_green_90</item>
        <item
            name="colorOnTertiaryContainer"
        >@color/onTertiaryContainer_green_10</item>

        <item name="colorError">@color/error_red_40</item>
        <item name="colorErrorContainer">@color/errorContainer_red_100</item>
        <item name="colorOnError">@color/onError_red_90</item>
        <item name="colorOnErrorContainer">@color/onErrorContainer_red_10</item>

        <item
            name="android:colorBackground"
        >@color/background_neutral_100</item>
        <item name="colorOnBackground">@color/onBackground_neutral_10</item>

        <item name="colorSurface">@color/surface_neutral_100</item>
        <item name="colorOnSurface">@color/onSurface_neutral_10</item>

        <item
            name="colorSurfaceVariant"
        >@color/surfaceVariant_neutral_variant_90</item>
        <item
            name="colorOnSurfaceVariant"
        >@color/onSurfaceVariant_neutral_variant_30</item>

        <item name="colorOutline">@color/outline_neutral_variant_50</item>

        <item name="questionnaire_theme">@style/Questionnaire</item>
    </style>

    <style name="AppCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">8dp</item>
    </style>

    <style name="AppTheme.PatientDetails">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="AppTheme.PatientDetails.headline">
        <item
            name="android:textAppearance"
        >?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="AppTheme.PatientDetails.Subtitle2">
        <item
            name="android:textAppearance"
        >?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="AppTheme.PatientDetails.body2">
        <item
            name="android:textAppearance"
        >?attr/textAppearanceBodyMedium</item>
    </style>
    
    <!-- Look of the data-capture forms. Fonts are kept to what the form really needs: every text
         with its own font family costs a typeface lookup for each row that is inflated. -->
    <style name="Questionnaire.questionnaireQuestionTextStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Questionnaire.questionnaireGroupTypeQuestionTextStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Questionnaire.questionnaireTextInputEditTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:layout_margin">0sp</item>
    </style>

    <style
        name="Questionnaire.questionnaireTextInputLayoutStyle"
        parent="Widget.Material3.TextInputLayout.OutlinedBox"
    >
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style
        name="Questionnaire.questionnaireRadioButtonStyle"
        parent="Widget.Material3.CompoundButton.RadioButton"
    >
        <item name="buttonTint">?attr/colorPrimary</item>
    </style>

    <style
        name="Questionnaire.questionnaireSubmitButtonStyle"
        parent="Widget.Material3.Button"
    >
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
    </style>
    <style name="Questionnaire.questionnaireBottomNavContainerStyle">
        <item name="android:background">?attr/colorSurface</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>
    <style name="Questionnaire" parent="Theme.Questionnaire">
        <item name="colorPrimary">@color/o3_primary</item>
        <item name="colorOnPrimary">@color/o3_on_primary</item>
        <item name="colorPrimaryContainer">@color/o3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/o3_on_primary_container</item>
        <item name="colorSecondary">@color/o3_secondary</item>
        <item name="colorSurface">@color/o3_surface</item>
        <item name="colorOnSurface">@color/o3_on_surface</item>
        <item name="colorSurfaceVariant">@color/o3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/o3_on_surface_variant</item>
        <item name="colorOutline">@color/o3_outline</item>
        <item name="android:colorBackground">@color/o3_background</item>
        <item
            name="questionnaireQuestionTextStyle"
        >@style/Questionnaire.questionnaireQuestionTextStyle</item>
        <item
            name="questionnaireGroupTypeQuestionTextStyle"
        >@style/Questionnaire.questionnaireGroupTypeQuestionTextStyle</item>
        <item
            name="questionnaireTextInputEditTextStyle"
        >@style/Questionnaire.questionnaireTextInputEditTextStyle</item>
        <item
            name="questionnaireTextInputLayoutStyle"
        >@style/Questionnaire.questionnaireTextInputLayoutStyle</item>
        <item
            name="questionnaireRadioButtonStyle"
        >@style/Questionnaire.questionnaireRadioButtonStyle</item>
        <item
            name="questionnaireSubmitButtonStyle"
        >@style/Questionnaire.questionnaireSubmitButtonStyle</item>
        <item
            name="questionnaireButtonStyle"
        >@style/Questionnaire.questionnaireSubmitButtonStyle</item>

        <item
            name="questionnaireBottomNavContainerStyle"
        >@style/Questionnaire.questionnaireBottomNavContainerStyle</item>
    </style>

    <style name="CustomPatientTabLayout" parent="Widget.Material3.TabLayout">
        <!-- Set the TabLayout background to transparent so individual tab backgrounds are visible -->
        <item name="android:background">@android:color/transparent</item>

        <!-- Custom background for each tab item -->
        <item name="tabBackground">@drawable/tab_background_selector</item>

        <!-- Indicator color and height -->
        <item name="tabIndicatorColor">@color/tab_indicator_color_blue</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item
            name="tabIndicatorFullWidth"
        >false</item> <!-- Indicator only under the text -->
        <item name="tabIndicatorGravity">bottom</item>

        <!-- Text colors -->
        <item name="tabSelectedTextColor">@color/tab_text_color_primary</item>
        <item
            name="tabTextColor"
        >@color/tab_text_color_primary</item> <!-- Same color for unselected text as in image -->

        <!-- Tab padding -->
        <item name="tabPaddingStart">16dp</item>
        <item name="tabPaddingEnd">16dp</item>
        <item name="tabPaddingTop">8dp</item>
        <item name="tabPaddingBottom">8dp</item>

        <!-- Other properties -->
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabInlineLabel">true</item>
        <item name="textAllCaps">false</item>
        <item
            name="tabRippleColor"
        >?attr/colorControlHighlight</item> <!-- Ripple effect color -->

    </style>
    <!-- Style for the filled rectangular button -->
    <style
        name="App.Button.Rectangular"
        parent="Widget.MaterialComponents.Button"
    >
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">4dp</item>
        <item
            name="android:paddingTop"
        >12dp</item> <!-- Adjust padding for desired button height -->
        <item name="android:paddingBottom">12dp</item>
        <!-- You can also set a minHeight if padding isn't enough -->
        <!-- <item name="android:minHeight">52dp</item> -->
    </style>

    <!-- Style for the outlined rectangular button -->
    <style
        name="App.Button.Outlined.Rectangular"
        parent="Widget.MaterialComponents.Button.OutlinedButton"
    >
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <!-- <item name="android:minHeight">52dp</item> -->
    </style>
</resources>
