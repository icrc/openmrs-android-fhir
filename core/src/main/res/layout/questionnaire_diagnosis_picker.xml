<?xml version="1.0" encoding="utf-8" ?>
<!-- A question answered by searching a list of diagnoses (see DiagnosisPicker). The form library looks for the media view of every item it binds. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
>
  <com.google.android.fhir.datacapture.views.MediaView
        android:id="@+id/item_media"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
    />
  <androidx.compose.ui.platform.ComposeView
        android:id="@+id/diagnosis_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
    />
</LinearLayout>
